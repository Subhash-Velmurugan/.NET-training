@model IEnumerable<ContactManagementApp.Models.Contact>

<h2>Contact List</h2>

<p>
    @Html.ActionLink(
        "Create New",
        "Create",
        null,
        new { @class = "btn btn-primary" })
</p>

<table class="table table-bordered table-striped">

    <thead>
        <tr>
            <th>Id</th>
            <th>First Name</th>
            <th>Last Name</th>
            <th>Email</th>
            <th>Action</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.FirstName</td>
                <td>@item.LastName</td>
                <td>@item.Email</td>

                <td>
                    @Html.ActionLink(
                        "Delete",
                        "Delete",
                        new { id = item.Id },
                        new { @class = "btn btn-danger btn-sm" })
                </td>
            </tr>
        }

    </tbody>

</table>